# ---------------------------------------------------------------------------
# Paavai+ environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string. Managed Postgres is recommended in production.
DATABASE_URL="postgresql://paavai:paavai@localhost:5432/paavai?schema=public"

# --- Authentication ---------------------------------------------------------
# Administrators only — the student-facing platform is fully anonymous.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-me-with-a-32-byte-random-secret"
# Public base URL of the deployment (used for OAuth redirects / cookies).
AUTH_URL="http://localhost:3000"
# Set to 1 when running behind a trusted proxy/platform (Vercel, Fly, etc.).
AUTH_TRUST_HOST="true"

# --- Institution identity (see docs/INSTITUTION-CONFIG.md) ------------------
# These are PLACEHOLDERS. The college must supply the real values before launch.
NEXT_PUBLIC_COLLEGE_NAME="Paavai Institute of Technology"
NEXT_PUBLIC_COLLEGE_SHORT_NAME="Paavai"
NEXT_PUBLIC_SUPPORT_EMAIL=""

# --- Application ------------------------------------------------------------
# IANA timezone used to interpret and display all poll/event times.
APP_TIMEZONE="Asia/Kolkata"
# The seed requires a real password. See prisma/seed.ts.
SEED_ADMIN_EMAIL="admin@paavai.edu.in"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Paavai Administrator"
# Set to "true" to also create clearly-labelled synthetic [DEMO] fixtures for
# local development (never enabled in production).
SEED_DEMO_DATA="false"
# Optional student account for the student portal. Leave the password blank to
# skip creating it. Student accounts never receive administrative permissions.
SEED_STUDENT_EMAIL="student@paavai.edu.in"
SEED_STUDENT_PASSWORD=""
SEED_STUDENT_NAME="Aarav Kumar"
SEED_STUDENT_ROLL="PAV2023CS042"
SEED_STUDENT_DEPARTMENT="Computer Science & Engineering"
SEED_STUDENT_YEAR="3"
SEED_STUDENT_SEMESTER="5"
SEED_STUDENT_SECTION="A"
SEED_STUDENT_PHONE="+91 98765 43210"

# --- Security ---------------------------------------------------------------
# 32-byte base64 key encrypting admin TOTP secrets at rest.
SETTINGS_ENCRYPTION_KEY=""
# Rate limiting (per identifier / per IP).
AUTH_MAX_ATTEMPTS="8"
AUTH_WINDOW_MINUTES="15"
# Server-side pepper for non-reversible hashing of IPs/user agents in logs.
AUDIT_HASH_PEPPER="replace-me-with-a-random-pepper"
# Server-side pepper for hashing anonymous visitor cookies into `visitorHash`.
# Keep this secret and stable; rotating it invalidates existing voter scopes
# (users would appear to vote again in cleared-token edge cases).
VISITOR_HASH_PEPPER="replace-me-with-a-second-random-pepper"

# --- Optional integrations (leave blank to disable; see README) -------------
# Transactional email provider (announcement delivery). Disabled when blank.
EMAIL_PROVIDER=""
EMAIL_FROM=""
RESEND_API_KEY=""

# --- Testing ----------------------------------------------------------------
# Separate database used by integration tests. Tests are skipped when unset.
TEST_DATABASE_URL=""
# Base URL for end-to-end tests. Tests are skipped when unset.
E2E_BASE_URL=""
# Credentials asserted by the administrative e2e flow when provided.
E2E_ADMIN_EMAIL=""
E2E_ADMIN_PASSWORD=""